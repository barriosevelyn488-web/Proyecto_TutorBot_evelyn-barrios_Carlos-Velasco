    {
      "parameters": {
        "jsCode": "const matriculas = items.map(item => item.json);\n\nlet mensaje = \"📚 Tus tutorías:\\n\\n\";\n\nlet pendientes = matriculas.filter(m => m.estado === \"Pendiente\");\nlet asignadas = matriculas.filter(m => m.estado === \"Asignada\");\nlet finalizadas = matriculas.filter(m => m.estado === \"Finalizada\");\n\n\nmensaje += \"⏳ PENDIENTES\\n\\n\";\n\nif (pendientes.length === 0) {\n  mensaje += \"No tienes solicitudes pendientes.\\n\";\n} else {\n  pendientes.forEach(m => {\n    mensaje += `📘 Materia: ${m.nombre_materia}\\n`;\n    mensaje += `📌 Estado: ${m.estado}\\n`;\n    \n    if (m.tutor && m.tutor !== \"\") {\n      mensaje += `👨‍🏫 Tutor: ${m.tutor}\\n`;\n    }\n\n    if (m.dia && m.hora_inicio) {\n      mensaje += `🕒 Horario: ${m.dia} ${m.hora_inicio}-${m.hora_fin}\\n`;\n    }\n\n    mensaje += \"\\n\";\n  });\n}\n\n\nmensaje += \"\\n👨‍🏫 ASIGNADAS\\n\\n\";\n\nif (asignadas.length === 0) {\n  mensaje += \"No tienes tutorías asignadas.\\n\";\n} else {\n  asignadas.forEach(m => {\n    mensaje += `📘 Materia: ${m.nombre_materia}\\n`;\n    mensaje += `👨‍🏫 Tutor: ${m.tutor}\\n`;\n    mensaje += `🕒 Horario: ${m.dia} ${m.hora_inicio}-${m.hora_fin}\\n\\n`;\n  });\n}\n\n\nmensaje += \"\\n✅ FINALIZADAS\\n\\n\";\n\nif (finalizadas.length === 0) {\n  mensaje += \"No tienes tutorías finalizadas.\\n\";\n} else {\n  finalizadas.forEach(m => {\n    mensaje += `📘 Materia: ${m.nombre_materia}\\n`;\n    mensaje += `👨‍🏫 Tutor: ${m.tutor}\\n\\n`;\n  });\n}\n\n\nreturn [\n  {\n    json: {\n      chat_id: matriculas[0].chat_id,\n      mensaje\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
