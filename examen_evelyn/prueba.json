    {
      "parameters": {
        "jsCode": "const resumen = {};\nlet total = 0;\n\nfor (const item of items) {\n  const materia = item.json.materia;\n  if (!materia) continue;\n\n  resumen[materia] = (resumen[materia] || 0) + 1;\n  total++;\n}\n\nlet mensaje = \"📚 Resumen de Tutorías por Materia\\n\\n\";\nmensaje += \"----------------------------\\n\\n\";\n\n// Muestra las materias con el emoji solicitado\nif (resumen[\"Matemáticas\"]) {\n  mensaje += `🧮 Matemáticas: ${resumen[\"Matemáticas\"]}\\n\\n`;\n}\n\nif (resumen[\"Programación\"]) {\n  mensaje += `💻 Programación: ${resumen[\"Programación\"]}\\n\\n`;\n}\n\nif (resumen[\"Química\"]) {\n  mensaje += `🧪 Química: ${resumen[\"Química\"]}\\n\\n`;\n}\n\n// Si existen otras materias, también se muestran\nfor (const materia in resumen) {\n  if (\n    materia !== \"Matemáticas\" &&\n    materia !== \"Programación\" &&\n    materia !== \"Química\"\n  ) {\n    mensaje += `📘 ${materia}: ${resumen[materia]}\\n\\n`;\n  }\n}\n\nmensaje += `📈 TOTAL SEMANA: ${total}`;\n\nreturn [\n  {\n    json: {\n      mensaje\n    }\n  }\n];\n  "
      },
